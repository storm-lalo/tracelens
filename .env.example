# Server
PORT=3001
TRACELENS_DATA_DIR=./data

# Optional OpenAI-compatible LLM for narrative reports.
# Leave blank to use the built-in deterministic analyst.
TRACELENS_LLM_URL=
TRACELENS_LLM_KEY=
TRACELENS_LLM_MODEL=gpt-4o-mini

# Optional live providers (disabled by default; demo provider always available).
TRACELENS_ENABLE_LIVE_PROVIDERS=false
TRACELENS_LIVE_DNS_URL=
TRACELENS_LIVE_DNS_KEY=
TRACELENS_CT_URL=https://crt.sh
TRACELENS_CODE_SEARCH_URL=
