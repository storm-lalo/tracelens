{
  "name": "tracelens",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered OSINT investigation workspace",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev -w @tracelens/server",
    "dev:web": "npm run dev -w @tracelens/web",
    "build": "npm run typecheck && npm run build -w @tracelens/web",
    "typecheck": "tsc --noEmit -p tsconfig.base.json",
    "test": "vitest run --config vitest.config.ts",
    "cli": "npm run start -w @tracelens/cli",
    "start": "npm run start -w @tracelens/server",
    "publish:github": "powershell -ExecutionPolicy Bypass -File ./scripts/publish.ps1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
